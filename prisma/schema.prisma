generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("BUYER") // ADMIN, SELLER, BUYER
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  sellerId  String?  // References SellerProfile if role is SELLER
  
  cart          Cart?
  quotations    Quotation[]
  auditLogs     AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SellerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  businessName String
  products     Product[]
  quotations   Quotation[]
}

model Unit {
  id    String @id @default(cuid())
  code  String @unique // e.g. "kg", "g", "L"
  name  String // e.g. "Kilogram", "Gram"

  baseProducts Product[] @relation("BaseUnit")
  supportedProducts Product[] @relation("SupportedUnits")
  
  fromFactors ConversionFactor[] @relation("FromUnit")
  toFactors   ConversionFactor[] @relation("ToUnit")

  cartItems CartItem[]
  quotationItems QuotationItem[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  sku         String   @unique
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id])
  
  baseUnitId  String
  baseUnit    Unit     @relation("BaseUnit", fields: [baseUnitId], references: [id])
  
  supportedUnits Unit[] @relation("SupportedUnits")

  basePrice   Decimal  @db.Decimal(19, 6)
  gstRate     Decimal  @default(5.00) @db.Decimal(5, 2)
  status      String   @default("ACTIVE") // ACTIVE, DISCONTINUED
  isPublished Boolean  @default(true)

  conversionFactors ConversionFactor[]
  inventory         Inventory?
  cartItems         CartItem[]
  quotationItems    QuotationItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConversionFactor {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  
  fromUnitId String
  fromUnit   Unit    @relation("FromUnit", fields: [fromUnitId], references: [id])
  
  toUnitId   String
  toUnit     Unit    @relation("ToUnit", fields: [toUnitId], references: [id])
  
  factor     Decimal @db.Decimal(19, 6)

  @@unique([productId, fromUnitId, toUnitId])
}

model Inventory {
  id           String  @id @default(cuid())
  productId    String  @unique
  product      Product @relation(fields: [productId], references: [id])
  quantity     Decimal @db.Decimal(19, 6)
  reorderLevel Decimal @db.Decimal(19, 6) @default(0)
  updatedBy    String
  updatedAt    DateTime @updatedAt
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  
  productId String
  product   Product @relation(fields: [productId], references: [id])
  
  quantity  Decimal @db.Decimal(19, 6)
  
  unitId    String
  unit      Unit    @relation(fields: [unitId], references: [id])
  
  unitPrice Decimal @db.Decimal(19, 6)
  lineTotal Decimal @db.Decimal(19, 2)

  @@unique([cartId, productId])
}

model Quotation {
  id              String   @id @default(cuid())
  quotationNumber String   @unique
  
  userId          String
  buyer           User     @relation(fields: [userId], references: [id])
  
  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id])

  status          String   @default("SUBMITTED") // SUBMITTED, REVIEWED, APPROVED, PAID, COMPLETED, CANCELLED, REJECTED
  
  subtotal        Decimal  @db.Decimal(19, 2)
  taxAmount       Decimal  @db.Decimal(19, 2)
  totalAmount     Decimal  @db.Decimal(19, 2)

  items           QuotationItem[]

  submittedAt     DateTime?
  approvedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  
  orderedQuantity Decimal   @db.Decimal(19, 6)
  orderedUnitId   String
  orderedUnit     Unit      @relation(fields: [orderedUnitId], references: [id])
  
  baseUnit        String
  baseQuantity    Decimal   @db.Decimal(19, 6)
  
  unitPrice       Decimal   @db.Decimal(19, 6)
  lineTotal       Decimal   @db.Decimal(19, 2)
  gstApplied      Decimal   @db.Decimal(19, 2)

  conversionLog   ConversionLog?
}

model ConversionLog {
  id               String        @id @default(cuid())
  quotationItemId  String        @unique
  quotationItem    QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)
  
  orderedQuantity  Decimal       @db.Decimal(19, 6)
  orderedUnit      String
  conversionFactor Decimal       @db.Decimal(19, 6)
  baseQuantity     Decimal       @db.Decimal(19, 6)
  baseUnit         String
  unitPrice        Decimal       @db.Decimal(19, 6)
  lineTotal        Decimal       @db.Decimal(19, 2)
  createdAt        DateTime      @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  action       String
  resourceType String
  resourceId   String
  changes      Json?
  createdAt    DateTime @default(now())
}
